// Code signing for Sweep.
//
// Default: "Sign to Run Locally" (ad-hoc), so anyone can build and run without an Apple Developer account.
// To sign with your own team, create App/Local.xcconfig (git-ignored) with, for example:
//
//   DEVELOPMENT_TEAM = ABCDE12345
//   CODE_SIGN_IDENTITY = Apple Development
//
// A stable signature matters: macOS ties privacy permissions (Documents, Automation, Full Disk Access)
// to it, so ad-hoc builds may ask again after each rebuild.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
